# Dockerfile for Orchestrator Agent
FROM python:3.11-slim

WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the whole project
COPY . .

# Set environment variables
ENV PYTHONUNBUFFERED=True
ENV PORT=8080
ENV PYTHONPATH=/app

# Expose the port for the ADK UI
EXPOSE 8080

# Command to run the Custom ADK Web Server (OAuth Flow)
# If you switch back to IAP, you can revert this to CMD ["adk", "web", "--host", "0.0.0.0", "--port", "8080"]
CMD ["python", "orchestrator_agent/server.py"]
